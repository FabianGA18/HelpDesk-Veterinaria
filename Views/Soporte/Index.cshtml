@using Sistema_Gestión_Citas.Infraestructura
@using Sistema_Gestión_Citas.Models.Entidades
@model Sistema_Gestión_Citas.Models.ViewModels.BandejaViewModel
@{
    ViewData["Title"] = "Tickets";
    ViewData["Heading"] = "Tickets";
    ViewData["Buscador"] = true;
    var estados = new EstadoTiquete?[] { null, EstadoTiquete.Nuevo, EstadoTiquete.Asignado, EstadoTiquete.EnProgreso, EstadoTiquete.EnEspera, EstadoTiquete.Resuelto };
}
<form class="toolbar" method="get">
    <div class="tabs">
        @foreach (var e in estados)
        {
            @* Cada pestaña conserva los demás filtros aplicados *@
            <a class="tab @(Model.Estado == e ? "on" : "")" asp-action="Index"
               asp-route-estado="@(e?.Texto() ?? "Todos")" asp-route-prioridad="@Model.Prioridad"
               asp-route-categoria="@Model.CategoriaId" asp-route-q="@Model.Busqueda">@(e?.Texto() ?? "Todos")</a>
        }
    </div>
    <input type="hidden" name="estado" value="@(Model.Estado?.Texto() ?? "Todos")">
    <input type="hidden" name="q" value="@Model.Busqueda">
    <select name="prioridad" aria-label="Prioridad" onchange="this.form.submit()">
        <option value="">Toda prioridad</option>
        @foreach (var p in new[] { PrioridadTiquete.Alta, PrioridadTiquete.Media, PrioridadTiquete.Baja })
        {
            <option value="@p" selected="@(Model.Prioridad == p)">@p.Texto()</option>
        }
    </select>
    <select name="categoria" aria-label="Categoría" onchange="this.form.submit()">
        <option value="">Toda categoría</option>
        @foreach (var c in Model.Categorias)
        {
            <option value="@c.Id" selected="@(Model.CategoriaId == c.Id)">@c.Nombre</option>
        }
    </select>
</form>

<div class="list">
    @foreach (var t in Model.Tiquetes)
    {
        <partial name="_FilaTiquete" model="t" />
    }
    @if (Model.Tiquetes.Count == 0)
    {
        <div class="empty">@(Model.HayFiltros ? "No hay tiquetes que coincidan con los filtros." : "No hay tiquetes abiertos.")</div>
    }
</div>
