@model Sistema_Gestión_Citas.Models.ViewModels.BandejaViewModel
@{
    ViewData["Title"] = "Historial";
    ViewData["Heading"] = "Historial";
    ViewData["Buscador"] = true;
}
@* Tiquetes en estado «Cerrado» *@
<div class="list">
    @foreach (var t in Model.Tiquetes)
    {
        <partial name="_FilaTiquete" model="t" />
    }
    @if (Model.Tiquetes.Count == 0)
    {
        <div class="empty">@(string.IsNullOrWhiteSpace(Model.Busqueda) ? "Aún no hay tiquetes cerrados." : "No hay tiquetes cerrados que coincidan con la búsqueda.")</div>
    }
</div>
