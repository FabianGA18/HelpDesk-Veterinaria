@using Sistema_Gestión_Citas.Infraestructura
@model List<Sistema_Gestión_Citas.Models.ViewModels.TiqueteFilaViewModel>
@{
    ViewData["Title"] = "Mis tiquetes";
    ViewData["Heading"] = "Portal del solicitante";
}
<div class="tabs">
    <a class="tab" asp-action="Crear">Crear tiquete</a>
    <a class="tab on" asp-action="Mis">Mis tiquetes</a>
</div>

@* Solo los tiquetes del usuario autenticado (RNF-03) *@
<div class="list">
    @foreach (var t in Model)
    {
        <a class="trow @t.Prioridad.ClaseCss()" asp-controller="Tickets" asp-action="Detalle" asp-route-id="@t.Id">
            <span class="bar"></span>
            <div class="tid"><b>#@t.Id</b><small>@Formato.Relativo(t.FechaCreacion)</small></div>
            <div class="tmain"><b>@t.Asunto</b><small>@t.Categoria · @(t.Responsable ?? "Sin asignar")</small></div>
            <span class="pill @t.Prioridad.ClaseCss()">@t.Prioridad.Texto()</span>
            <span class="st @t.Estado.ClaseCss()"><i class="dot"></i>@t.Estado.Texto()</span>
            <span class="btn sm">Ver</span>
        </a>
    }

    @if (Model.Count == 0)
    {
        <div class="empty">Aún no has creado tiquetes.</div>
    }
</div>
