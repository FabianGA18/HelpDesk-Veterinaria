@using Sistema_Gestión_Citas.Infraestructura
@using Sistema_Gestión_Citas.Models.Entidades
@model Sistema_Gestión_Citas.Models.ViewModels.TiqueteDetalleViewModel
@{
    ViewData["Title"] = "Detalle del tiquete";
    ViewData["Heading"] = "Detalle del tiquete";
}
<a class="back" asp-action="Mis">← Volver a mis tiquetes</a>
<div class="card page-narrow detail">
    <small>#@Model.Id · @Formato.Fecha(Model.FechaCreacion)</small>
    <h2 style="font-size:22px;margin-top:2px">@Model.Asunto</h2>
    <div class="badges">
        <span class="pill @Model.Prioridad.ClaseCss()">@Model.Prioridad.Texto()</span>
        <span class="st @Model.Estado.ClaseCss()"><i class="dot"></i>@Model.Estado.Texto()</span>
        <span class="pill role">@Model.Categoria</span>
    </div>
    <small>Solicitante: @Model.Solicitante · Responsable: @(Model.Responsable ?? "Sin asignar")</small>
    <div class="sec"><h3>Descripción</h3><div class="box">@Model.Descripcion</div></div>
    <partial name="_Evidencias" model="Model.Evidencias" />
    @if (!string.IsNullOrWhiteSpace(Model.Solucion))
    {
        <div class="sec"><h3>Solución aplicada</h3><div class="box sol">@Model.Solucion</div></div>
    }

    @* Solo si el estado es «Resuelto» (RF-07) *@
    @if (Model.PuedeCerrar)
    {
        <div class="sec">
            <form method="post" asp-action="Cerrar" asp-route-id="@Model.Id">
                <button class="btn ok" type="submit">El problema fue resuelto: cerrar tiquete</button>
            </form>
        </div>
    }

    @* Solo si el tiquete no está cerrado (RF-04, RF-06) *@
    @if (Model.PuedeComentar)
    {
        <form class="sec" method="post" enctype="multipart/form-data" asp-action="Adjuntar" asp-route-id="@Model.Id">
            <h3>Adjuntar evidencia <small>(PDF, JPG o PNG, máx. 10 MB)</small></h3>
            <div class="field"><input type="file" name="Evidencias" multiple accept=".pdf,.jpg,.jpeg,.png" required></div>
            <button class="btn ghost sm" type="submit">Adjuntar</button>
        </form>

        <form class="sec" method="post" asp-action="Comentar" asp-route-id="@Model.Id">
            <h3>Agregar comentario</h3>
            <div class="field"><textarea name="Comentario" placeholder="Escribe un comentario o seguimiento..." style="min-height:80px"></textarea></div>
            <button class="btn sm" type="submit">Comentar</button>
        </form>
    }

    <div class="sec"><h3>Historial</h3>
        <div class="timeline">
            @foreach (var ev in Model.Historial)
            {
                <div class="ev @(ev.Tipo == TipoEvento.Comentario ? "comment" : "")"><small>@ev.Usuario · @Formato.Fecha(ev.Fecha)</small><div class="t">@ev.Descripcion</div></div>
            }
        </div>
    </div>
</div>
