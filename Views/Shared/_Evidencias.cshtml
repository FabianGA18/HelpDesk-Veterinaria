@model List<Sistema_Gestión_Citas.Models.ViewModels.EvidenciaViewModel>
@* Lista de evidencias del tiquete (HU-03). La descarga revisa permisos en el servidor. *@
@if (Model.Count > 0)
{
    <div class="sec"><h3>Evidencia</h3>
        <div class="files">
            @foreach (var e in Model)
            {
                <a class="file" asp-controller="Evidencias" asp-action="Descargar" asp-route-id="@e.Id" title="Descargar">📎 @e.Nombre <small>(@e.Tamano)</small></a>
            }
        </div>
    </div>
}
