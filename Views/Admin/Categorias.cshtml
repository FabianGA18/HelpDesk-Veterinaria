@model List<Sistema_Gestión_Citas.Models.ViewModels.CategoriaFilaViewModel>
@{
    ViewData["Title"] = "Categorías";
    ViewData["Heading"] = "Administración";
}
<div class="tabs">
    <a class="tab on" asp-action="Categorias">Categorías</a>
    <a class="tab" asp-action="Usuarios">Usuarios y roles</a>
    <a class="tab" asp-action="Prioridad">Tiquetes por prioridad</a>
</div>

<div class="card">
    <div class="card-h"><h2>Categorías</h2><a class="btn" asp-action="CategoriaForm">Nueva categoría</a></div>
    <div class="thead cols-cat"><span>Categoría</span><span>Tiquetes activos</span><span>Estado</span><span></span></div>
    @foreach (var c in Model)
    {
        <div class="drow cols-cat"><b>@c.Nombre</b><span>@c.TiquetesActivos</span><span class="@(c.Activa ? "status-ok" : "status-off")"><i></i>@(c.Activa ? "Activa" : "Inactiva")</span><a class="btn ghost sm" asp-action="CategoriaForm" asp-route-id="@c.Id">Editar</a></div>
    }
    @if (Model.Count == 0)
    {
        <div class="empty">Aún no hay categorías.</div>
    }
</div>
