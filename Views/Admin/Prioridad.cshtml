@using Sistema_Gestión_Citas.Infraestructura
@using Sistema_Gestión_Citas.Models.Entidades
@model Sistema_Gestión_Citas.Models.ViewModels.PrioridadAdminViewModel
@{
    ViewData["Title"] = "Tiquetes por prioridad";
    ViewData["Heading"] = "Administración";
}
<div class="tabs">
    <a class="tab" asp-action="Categorias">Categorías</a>
    <a class="tab" asp-action="Usuarios">Usuarios y roles</a>
    <a class="tab on" asp-action="Prioridad">Tiquetes por prioridad</a>
</div>

<div class="stats">
    @foreach (var p in new[] { PrioridadTiquete.Alta, PrioridadTiquete.Media, PrioridadTiquete.Baja })
    {
        PrioridadTiquete? valor = p;
        <a class="stat @valor.ClaseCss() @(Model.Prioridad == p ? "on" : "")" asp-action="Prioridad" asp-route-prioridad="@p" style="text-decoration:none;color:inherit"><span class="pill @valor.ClaseCss()">@p.Texto()</span><div class="n">@Model.Conteos.GetValueOrDefault(p)</div><small>tiquetes abiertos</small></a>
    }
    <a class="stat @(Model.Prioridad is null ? "on" : "")" asp-action="Prioridad" style="--c:var(--primary);text-decoration:none;color:inherit"><span class="pill" style="--c:var(--primary)">Todos</span><div class="n">@Model.TotalAbiertos</div><small>tiquetes abiertos</small></a>
</div>

<div class="card">
    <div class="card-h"><h2>Tiquetes por prioridad</h2></div>
    <div class="thead cols-pri"><span>ID</span><span>Asunto</span><span>Prioridad</span><span>Responsable</span><span>Estado</span></div>
    @foreach (var t in Model.Tiquetes)
    {
        <a class="drow cols-pri" asp-controller="Soporte" asp-action="Detalle" asp-route-id="@t.Id" style="text-decoration:none;color:inherit"><b style="color:#b9c6ff">#@t.Id</b><b>@t.Asunto</b><span><span class="pill @t.Prioridad.ClaseCss()">@t.Prioridad.Texto()</span></span><span>@(t.Responsable ?? "Sin asignar")</span><span class="status-ok @t.Estado.ClaseCss()"><i style="background:var(--c)"></i>@t.Estado.Texto()</span></a>
    }
    @if (Model.Tiquetes.Count == 0)
    {
        <div class="empty">No hay tiquetes abiertos@(Model.Prioridad is null ? "" : " con esa prioridad").</div>
    }
</div>
