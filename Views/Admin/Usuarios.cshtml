@model List<Sistema_Gestión_Citas.Models.ViewModels.UsuarioFilaViewModel>
@{
    ViewData["Title"] = "Usuarios y roles";
    ViewData["Heading"] = "Administración";
}
<div class="tabs">
    <a class="tab" asp-action="Categorias">Categorías</a>
    <a class="tab on" asp-action="Usuarios">Usuarios y roles</a>
    <a class="tab" asp-action="Prioridad">Tiquetes por prioridad</a>
</div>

<div class="card">
    <div class="card-h"><h2>Usuarios y roles</h2><a class="btn" asp-action="UsuarioForm">Nuevo usuario</a></div>
    <div class="thead cols-usr"><span>Nombre</span><span>Correo</span><span>Rol</span><span>Estado</span><span></span></div>
    @foreach (var u in Model)
    {
        <div class="drow cols-usr"><b>@u.Nombre</b><span style="word-break:break-all">@u.Correo</span><span><span class="pill role">@u.Rol</span></span><span class="@(u.Activo ? "status-ok" : "status-off")"><i></i>@(u.Activo ? "Activo" : "Inactivo")</span><a class="btn ghost sm" asp-action="UsuarioForm" asp-route-id="@u.Id">Editar</a></div>
    }
</div>
