@model Sistema_Gestión_Citas.Models.ViewModels.LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Iniciar sesión";
}
<div class="login-wrap">
    <form class="login" method="post" asp-controller="Login" asp-action="InicioSesión" novalidate>
        <div class="brand"><div class="logo" aria-hidden="true">🐾</div></div>
        <h2>Soporte Veterinario</h2>
        <p class="sub">Inicia sesión para continuar</p>

        <div class="field">
            <label for="Usuario">Usuario (correo)</label>
            <input id="Usuario" name="Usuario" type="email" autocomplete="username" placeholder="correo@@empresa.com" value="@Model?.Usuario">
        </div>
        <div class="field">
            <label for="Password">Contraseña</label>
            <input id="Password" name="Password" type="password" autocomplete="current-password" placeholder="••••">
        </div>
        <input type="hidden" name="ReturnUrl" value="@Model?.ReturnUrl">
        <div class="err" role="alert">@ViewData["Error"]</div>
        <button class="btn block" type="submit">Ingresar</button>
    </form>
</div>